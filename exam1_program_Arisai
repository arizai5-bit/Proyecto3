8. Crea un script que reciba como parámetros el nombre de archivo, columna de incio, columna fin y que calcular la distancia y saque el promedio de distancias.

awk -F '\t' '
NR>1 {print $2}' mirna_human_ensembl_hg38.txt > inicio.txt


awk -F '\t' '
NR>1 {print $3}' mirna_human_ensembl_hg38.txt > fin.txt


#!/bin/bash
inicio=$2
fin=$3

awk -F '\t' '
NR>1 {
    distancia=$fin - $inicio
    sum[$5]+=distancia
    n[$5]++
}
END{
    printf "Distancia = %.1f\n", sum[1]/n[1]
}
' $2 $3


